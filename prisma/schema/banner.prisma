model Banner {
  id        String         @id @default(uuid())
  title     String
  image     String
  link      String?
  position  BannerPosition @default(HERO_SLIDER)
  isActive  Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("banners")
}