model OrderItem {
  id         String         @id @default(uuid())
  subOrderId String
  subOrder   SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  price      Float
  createdAt  DateTime       @default(now())

  @@map("order_items")
}